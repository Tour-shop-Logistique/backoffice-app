# URL RACINE de votre API Backend (sans /api à la fin, ajouté automatiquement par le code)
# Développement : URL ngrok ou localhost
# Production : URL de votre API déployée
VITE_API_URL=https://votre-api.com

# WebSocket (Laravel Reverb, self-hosted) — doit matcher les REVERB_* du backend
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=https
